public class StringRotation {
    public static void main(String[] args) {

        String str1 = "abcd";
        String str2 = "cdab";

        boolean rotation =
            str1.length() == str2.length()
            && (str1 + str1).contains(str2);

        if (rotation)
            System.out.println("Strings are rotations");
        else
            System.out.println("Strings are not rotations");
    }
}
